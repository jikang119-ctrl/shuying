# 《疏影》nginx 站点配置。由 deploy/install.sh 生成到 /etc/nginx/conf.d/shuying.conf
# __PASSCODE__ / __ROOT__ / __PORT__ / __API_PORT__ 由 install.sh 替换，别手改模板里的占位符。

# 进门的四位数存在 cookie「shuying」里，和这里对上才放行
map $cookie_shuying $shuying_ok {
    default 0;
    "__PASSCODE__" 1;
}
# 没进门的请求按 IP 限速（每分钟 10 次），防止有人挨个试；进了门的不限
map $shuying_ok $shuying_gate_key {
    0 $binary_remote_addr;
    1 "";
}
limit_req_zone $shuying_gate_key zone=shuying_gate:1m rate=10r/m;
# 寄信和读信：不管进没进门都按 IP 限速
limit_req_zone $binary_remote_addr zone=shuying_post:1m rate=6r/m;
limit_req_status 429;

server {
    listen __PORT__;
    listen [::]:__PORT__;
    server_name _;
    root __ROOT__;
    charset utf-8;

    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;

    client_max_body_size 16k;

    gzip on;
    gzip_comp_level 5;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # 密码页和它用到的字体、样式不设门
    location = /lock.html {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000";
        try_files $uri =404;
    }

    # 注意：限速（limit_req）在 nginx 的 preaccess 阶段，而 location 里的 if/return 在更早的 rewrite 阶段。
    # 所以要设门的地方都先过 limit_req，再用 try_files 跳到命名 location 里做判断，限速才真的生效。

    # 密码页用它来验证：对了回 204，不对回 401
    location = /gate {
        limit_req zone=shuying_gate burst=5 nodelay;
        try_files /.shuying-no-such-file @gate;
    }
    location @gate {
        if ($shuying_ok = 0) { return 401; }
        return 204;
    }

    # 照片和正文都要进门
    location /photos/ {
        limit_req zone=shuying_gate burst=30 nodelay;
        try_files /.shuying-no-such-file @photos;
    }
    location @photos {
        if ($shuying_ok = 0) { return 403; }
        expires 30d;
        add_header Cache-Control "private, max-age=2592000";
        try_files $uri =404;
    }
    # 唱片柜：页面和歌都要进门。歌在 __ROOT__/music/（不在仓库里，用 deploy/upload-music 单独传）
    location = /music.html {
        limit_req zone=shuying_gate burst=30 nodelay;
        try_files /.shuying-no-such-file @musicpage;
    }
    location @musicpage {
        if ($shuying_ok = 0) { return 302 /lock.html?next=music.html; }
        add_header Cache-Control "no-cache";
        try_files /music.html =404;
    }
    location /music/ {
        limit_req zone=shuying_gate burst=60 nodelay;
        try_files /.shuying-no-such-file @music;
    }
    location @music {
        if ($shuying_ok = 0) { return 403; }
        # 文件名是内容哈希，不会变，可以一直缓存；拖进度条靠 nginx 自带的 Range
        add_header Cache-Control "private, max-age=31536000, immutable";
        try_files $uri =404;
    }
    location = / {
        limit_req zone=shuying_gate burst=30 nodelay;
        try_files /.shuying-no-such-file @home;
    }
    location = /index.html {
        limit_req zone=shuying_gate burst=30 nodelay;
        try_files /.shuying-no-such-file @home;
    }
    location @home {
        if ($shuying_ok = 0) { return 302 /lock.html; }
        add_header Cache-Control "no-cache";
        try_files /index.html =404;
    }
    # 回信：寄信要进门；读信还要读信码（后端核对）
    location = /api/letters {
        limit_req zone=shuying_post burst=3 nodelay;
        try_files /.shuying-no-such-file @api;
    }
    location = /api/inbox {
        limit_req zone=shuying_post burst=5 nodelay;
        try_files /.shuying-no-such-file @api;
    }
    location @api {
        if ($shuying_ok = 0) { return 403; }
        proxy_pass http://127.0.0.1:__API_PORT__;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 10s;
    }
    location = /inbox.html {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location / {
        return 404;
    }
}
